# Copy to .env and adjust as needed. Never commit the real .env file.

LABELFORGE_DB_PATH=./data/labelforge.db
LABELFORGE_USER_NAME=local

# AI-assisted labeling (milestone 2). Without this set, LabelForge still works —
# AI predictions/prompt features just stay unavailable and everything degrades
# to milestone-1 behavior. Never commit a real value.
# ANTHROPIC_API_KEY=
LABELFORGE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Reserved for a future non-Anthropic LLMProvider — never commit real values:
# OPENAI_API_KEY=
